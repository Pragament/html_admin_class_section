rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Student access is additive to the teacher/admin permissions below.
    function profile() {
      return get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data;
    }

    function activeStudent() {
      return signedIn() && profile().active == true
        && profile().authUid == request.auth.uid;
    }

    // Use section-specific identities while retaining legacy single-section profiles.
    function sectionMembership(sectionId) {
      return profile().get('memberships', {}).get(sectionId, {
        'studentDocId': profile().get('studentDocId', ''),
        'admissionNo': profile().get('admissionNo', ''),
        'studentKey': profile().get('studentKey', ''),
        'active': sectionId == profile().get('sectionId', '') && profile().active == true
      });
    }

    function activeSection(sectionId) {
      return activeStudent() && sectionMembership(sectionId).active == true;
    }

    function submissionOwner(data) {
      return data.authUid == request.auth.uid
        && data.email == request.auth.token.email
        && activeSection(data.sectionId)
        && data.studentKey == sectionMembership(data.sectionId).studentKey
        && data.admissionNo == sectionMembership(data.sectionId).admissionNo
        && data.answers is list && data.questionCount is int;
    }

    function submissionClassroom(data) {
      let classroom = get(/databases/$(database)/documents/classrooms/$(data.classroomId)).data;
      return classroom.sectionId == data.sectionId
        && activeSection(classroom.sectionId)
        && classroom.classEnabled == true && classroom.get('archived', false) != true;
    }

    function practiceDraft(data) {
      return data.get('practiceProgress', false) == true
        && data.get('status', '') in ['in_progress', 'paused'];
    }

    function validPracticeDraft(data) {
      let classroom = get(/databases/$(database)/documents/classrooms/$(data.classroomId)).data;
      return practiceDraft(data)
        && classroom.get('mode', '') in ['practice', 'reading_practice', 'writing_practice']
        && data.progressVersion == 1 && data.practiceState is string
        && data.practiceState.size() < 900000
        && data.questionCount > 0 && data.answers.size() == data.questionCount
        && data.currentIndex is int && data.currentIndex >= 0 && data.currentIndex < data.questionCount
        && data.updatedAtMillis is number;
    }

    function isSchoolAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/schoolAdmins/$(request.auth.uid));
    }

    function hasSectionRole(sectionData, role) {
      return signedIn()
        && request.auth.token.email is string
        && { 'email': request.auth.token.email.lower(), 'role': role } in sectionData.members;
    }

    function canViewSection(sectionData) {
      return hasSectionRole(sectionData, 'admin') || hasSectionRole(sectionData, 'viewer');
    }

    function canAdminSection(sectionData) {
      return hasSectionRole(sectionData, 'admin');
    }

    function ownsClassroom(classroomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId))
        && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.creatorId == request.auth.uid;
    }

    function ownsQuestionBankList(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/qb_lists_v1/$(listId))
        && get(/databases/$(database)/documents/qb_lists_v1/$(listId)).data.ownerUid == request.auth.uid;
    }

    function sectionExists(sectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classSections/$(sectionId))
        && canViewSection(get(/databases/$(database)/documents/classSections/$(sectionId)).data);
    }

    function hasValidQuestionBankList() {
      return !('questionBankListId' in request.resource.data)
        || ownsQuestionBankList(request.resource.data.questionBankListId);
    }

    function hasValidSection() {
      return !('sectionId' in request.resource.data)
        || sectionExists(request.resource.data.sectionId);
    }

    function canAdminClassroomSection(classroomData) {
      return signedIn()
        && classroomData.sectionId is string
        && exists(/databases/$(database)/documents/classSections/$(classroomData.sectionId))
        && canAdminSection(get(/databases/$(database)/documents/classSections/$(classroomData.sectionId)).data);
    }

    function canReviewSubmission(submissionData) {
      return ownsClassroom(submissionData.classroomId)
        || (
          signedIn()
          && submissionData.sectionId is string
          && exists(/databases/$(database)/documents/classSections/$(submissionData.sectionId))
          && canAdminSection(get(/databases/$(database)/documents/classSections/$(submissionData.sectionId)).data)
        );
    }

    function isAiReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'answers',
        'aiReviewUpdatedAt',
        'aiReviewUpdatedBy',
        'aiReviewUpdatedByEmail'
      ])
      && resource.data.answers is list
      && request.resource.data.answers is list
      && request.resource.data.answers.size() == resource.data.answers.size()
      && request.resource.data.aiReviewUpdatedAt is number
      && request.resource.data.aiReviewUpdatedBy == request.auth.uid
      && request.auth.token.email is string
      && request.resource.data.aiReviewUpdatedByEmail == request.auth.token.email;
    }

    match /studentProfiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Taxonomy labels are shared metadata used by the teacher and student apps.
    match /qb_taxonomy_v1/{taxonomyId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.type in ['class', 'subject', 'chapter', 'topic']
        && request.resource.data.label is string;
      allow delete: if false;
    }

    // Passages become public when first used by a published question.
    // Keep them readable for other published questions when one child is archived.
    match /qb_comprehensions_v1/{comprehensionId} {
      allow read: if resource.data.published == true
        || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.passageHtml is string
        && request.resource.data.published is bool;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.passageHtml is string
        && request.resource.data.published is bool
        && (resource.data.published == false || request.resource.data.published == true);
      allow delete: if false;
    }

    match /qb_questions_v1/{questionId} {
      // Published questions are public in Question Bank Studio.
      allow read: if resource.data.status == 'published'
        || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if false;
    }

    match /qb_reactions_v1/{reactionId} {
      allow read: if true;

      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && reactionId == request.resource.data.questionId + '_' + request.auth.uid;

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // School structure and admission claims are written only by the trusted admin API.
    match /schoolOrganisations/{orgCode} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /schoolBranches/{branchCode} {
      allow read: if signedIn();
      allow write: if false;
      match /admissions/{admissionNo} {
        allow read, write: if false;
      }
    }

    match /classSections/{sectionId} {
      allow read: if canViewSection(resource.data);
      allow create, delete: if false;
      allow update: if (isSchoolAdmin() || canAdminSection(resource.data))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['branchId', 'branchCode', 'orgId']);

      match /aiConfigs/{configId} {
        function sectionMember() {
          return signedIn() && canViewSection(get(/databases/$(database)/documents/classSections/$(sectionId)).data);
        }
        function validConfig() {
          let data = request.resource.data;
          return data.keys().hasAll(['name', 'provider', 'apiKey', 'baseURL', 'models', 'authorUid', 'createdAt', 'updatedAt'])
            && data.keys().hasOnly(['name', 'provider', 'apiKey', 'baseURL', 'models', 'authorUid', 'createdAt', 'updatedAt'])
            && data.name is string && data.name.size() > 0 && data.name.size() <= 100
            && data.apiKey is string && data.apiKey.size() > 0 && data.apiKey.size() <= 4096
            && data.models is list && data.models.size() > 0 && data.models.size() <= 6
            && data.models.toSet().size() == data.models.size()
            && data.updatedAt == request.time && data.createdAt is timestamp
            && ((data.provider == 'gemini'
                && data.baseURL == 'https://generativelanguage.googleapis.com/v1beta/openai/'
                && data.models.hasOnly(['gemini-3.8-flash', 'gemini-3.8-pro', 'gemini-2.5-flash', 'gemini-2.5-pro']))
              || (data.provider == 'pollinations'
                && data.baseURL == 'https://gen.pollinations.ai/v1'
                && data.models.hasOnly(['openai/gpt-5.4-nano', 'openai/gpt-6-luna', 'openai/gpt-6-sol', 'google/gemini-4-argon', 'anthropic/claude-sonnet-5.5', 'deepseek/deepseek-v4.1-flash'])));
        }
        allow read, delete: if sectionMember() && resource.data.authorUid == request.auth.uid;
        allow create: if sectionMember() && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time && validConfig();
        allow update: if sectionMember() && resource.data.authorUid == request.auth.uid
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.createdAt == resource.data.createdAt && validConfig();
      }

      match /students/{studentId} {
        allow read: if exists(/databases/$(database)/documents/classSections/$(sectionId))
          && canViewSection(get(/databases/$(database)/documents/classSections/$(sectionId)).data);
        // The API reserves admission numbers transactionally across all sections.
        allow write: if false;
      }
    }

    match /classrooms/{classroomId} {
      allow read: if activeStudent() && activeSection(resource.data.sectionId);
      allow read: if signedIn()
        && (resource.data.creatorId == request.auth.uid || canAdminClassroomSection(resource.data));
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && hasValidQuestionBankList()
        && hasValidSection();
      allow update: if signedIn()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == resource.data.creatorId
        && hasValidQuestionBankList()
        && hasValidSection();
      allow delete: if false;
    }

    match /qb_lists_v1/{listId} {
      allow read: if activeStudent();
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
    
    match /qb_reactions_v1/{reactionId} {
      function validReactionSource(data) {
        return data.sourceType is string && data.sourceValue is string
          && ((data.sourceType == 'practice' && data.sourceValue == 'homepage')
            || (data.sourceType == 'quiz-session'
              && activeSection(get(/databases/$(database)/documents/classrooms/$(data.sourceValue)).data.sectionId)
              && get(/databases/$(database)/documents/classrooms/$(data.sourceValue)).data.classEnabled == true
              && get(/databases/$(database)/documents/classrooms/$(data.sourceValue)).data.get('archived', false) != true));
      }
      allow get: if activeStudent() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if activeStudent() && resource.data.userId == request.auth.uid;
      allow create, update: if activeStudent()
        && request.resource.data.keys().hasAll(['questionId', 'userId', 'value', 'updatedAt', 'sourceType', 'sourceValue'])
        && request.resource.data.keys().hasOnly(['questionId', 'userId', 'value', 'updatedAt', 'comment', 'sourceType', 'sourceValue'])
        && validReactionSource(request.resource.data)
        && request.resource.data.questionId is string
        && request.resource.data.userId == request.auth.uid
        && reactionId == request.resource.data.questionId + '__' + request.auth.uid
        && (resource == null || (resource.data.userId == request.auth.uid
          && resource.data.questionId == request.resource.data.questionId))
        && request.resource.data.value in ['like', 'dislike']
        && request.resource.data.updatedAt == request.time
        && (!('comment' in request.resource.data)
          || (request.resource.data.comment is string && request.resource.data.comment.size() <= 2000))
        && get(/databases/$(database)/documents/qb_questions_v1/$(request.resource.data.questionId)).data.status == 'published';
      allow delete: if false;
    }

    // Merge this read grant with existing student reaction write permissions.
    match /qb_reactions_v1/{reactionId} {
      allow read: if signedIn()
        && resource.data.sourceType == 'quiz-session'
        && (ownsClassroom(resource.data.sourceValue)
          || canAdminClassroomSection(get(/databases/$(database)/documents/classrooms/$(resource.data.sourceValue)).data));
    }

    match /qb_quiz_submissions_v1/{submissionId} {
      // Strongest option, if submissions include teacherUid:
      // allow read: if signedIn() && resource.data.teacherUid == request.auth.uid;

      // Works for classroom owners, and for section admins when submissions include sectionId.
      allow read: if canReviewSubmission(resource.data);

      allow update: if canReviewSubmission(resource.data) && isAiReviewUpdate();
      // Also permits the student's historical submissions without authUid.
      allow read: if activeStudent()
        && ((resource.data.get('sectionId', '') != ''
            && activeSection(resource.data.sectionId)
            && resource.data.studentKey == sectionMembership(resource.data.sectionId).studentKey)
          || (activeSection(profile().sectionId) && resource.data.studentKey == profile().studentKey));
      allow create: if activeStudent()
        && submissionOwner(request.resource.data) && submissionClassroom(request.resource.data)
        && (!request.resource.data.get('practiceProgress', false) || validPracticeDraft(request.resource.data));
      // Completed and historical submissions remain immutable to students.
      allow update: if activeStudent() && practiceDraft(resource.data)
        && resource.data.authUid == request.auth.uid
        && submissionOwner(request.resource.data) && submissionClassroom(request.resource.data)
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.studentKey == resource.data.studentKey
        && request.resource.data.classroomId == resource.data.classroomId
        && (validPracticeDraft(request.resource.data)
          || (request.resource.data.get('practiceProgress', false) == false
            && request.resource.data.submittedAt is timestamp
            && request.resource.data.submittedAtMillis is number));
      allow delete: if false;
    }

    // Email admin app: intentionally unauthenticated, scoped to this tree.
    // These grants are public. They do not authenticate a user or organization.
    match /organizations/{orgId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll([
          'id', 'name', 'adminEmail', 'domains', 'createdAt', 'clientApiKey', 'moderators'])
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'adminEmail', 'domains', 'createdAt', 'clientApiKey', 'moderators'])
        && request.resource.data.id == orgId
        && request.resource.data.name is string
        && request.resource.data.adminEmail is string
        && request.resource.data.domains is list
        && request.resource.data.moderators is list
        && request.resource.data.createdAt is timestamp
        && request.resource.data.clientApiKey is string;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['domains', 'moderators'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['domains'])
          || request.resource.data.domains is list)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderators'])
          || request.resource.data.moderators is list);
      allow delete: if false;

      match /accounts/{accountId} {
        // Client web registration creates client-role accounts directly.
        function validClientRegistration() {
          let data = request.resource.data;
          return exists(/databases/$(database)/documents/organizations/$(orgId))
            && data.keys().hasAll(['id', 'orgId', 'email', 'password', 'role', 'createdAt'])
            && data.keys().hasOnly(['id', 'orgId', 'email', 'displayName', 'password', 'role', 'createdAt'])
            && data.id == accountId && data.orgId == orgId
            && data.email is string && data.email.size() > 0
            && data.email == data.email.lower()
            && data.password is string && data.password.size() >= 6
            && data.role == 'client' && data.createdAt is timestamp
            && (data.get('displayName', null) == null || data.displayName is string);
        }
        function validAccountEdit() {
          let data = request.resource.data;
          let changed = data.diff(resource.data).affectedKeys();
          return changed.hasOnly(['email', 'password', 'displayName'])
            && (!changed.hasAny(['email']) || data.email is string)
            && (!changed.hasAny(['password']) || data.password is string)
            && (!changed.hasAny(['displayName'])
              || data.get('displayName', null) == null || data.displayName is string);
        }
        allow read, delete: if true;
        allow create: if validClientRegistration();
        // Validate changed fields so password-only edits work for legacy docs.
        allow update: if validAccountEdit();

        match /emails/{messageId} {
          function validEmail() {
            let data = request.resource.data;
            return data.keys().hasAll([
                'id', 'orgId', 'accountId', 'toEmail', 'toName', 'fromEmail',
                'fromName', 'subject', 'body', 'snippet', 'isHtml', 'datetime'])
              && data.keys().hasOnly([
                'id', 'orgId', 'accountId', 'toEmail', 'toName', 'fromEmail',
                'fromName', 'subject', 'body', 'snippet', 'isHtml', 'datetime'])
              && data.id == messageId && data.orgId == orgId && data.accountId == accountId
              && data.toEmail is string && data.toName is string
              && data.fromEmail is string && data.fromName is string
              && data.subject is string && data.body is string && data.snippet is string
              && data.isHtml is bool && data.datetime is timestamp;
          }
          allow read: if true;
          // Repeated Gmail IDs use set(), so updates must be allowed for replay.
          allow create, update: if validEmail();
          allow delete: if false;
        }
      }

      match /otps/{otpId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasAll([
            'id', 'orgId', 'code', 'createdAt', 'expiresAt'])
          && request.resource.data.keys().hasOnly([
            'id', 'orgId', 'code', 'createdAt', 'expiresAt'])
          && request.resource.data.id == otpId && request.resource.data.orgId == orgId
          && request.resource.data.code is string
          && request.resource.data.code.matches('^[0-9]{6}$')
          && request.resource.data.createdAt is timestamp
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.resource.data.createdAt;
        allow update, delete: if false;
      }
    }
  }
}
